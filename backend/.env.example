# Copy to backend/.env and adjust. All settings use the TC_ prefix.
# REQUIRED for any shared deployment: a long random secret (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
TC_SECRET_KEY=change-me

# Empty = SQLite file in TC_DATA_DIR. For PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/tenjicheck
TC_DATABASE_URL=
TC_DATA_DIR=./data
TC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TC_MAX_UPLOAD_MB=10
TC_BLUR_MIN_VARIANCE=60

# Vision models (see README "AI components")
TC_OBSTACLE_ENABLED=true
TC_OBSTACLE_MODEL=yolov8s-worldv2.pt
TC_OBSTACLE_CONFIDENCE=0.15
# Path to fine-tuned YOLOv8n-seg tactile tile weights; empty = classical baseline segmenter
TC_TILE_MODEL_PATH=
# Live path planner surface model: fast (SegFormer-b0, ~0.2 s) | accurate (SegFormer-b2, ~0.7 s). Weights: scripts/fetch_models.py
TC_SURFACE_QUALITY=accurate

# Optional: GitHub Models, used by the live view's vision-LLM second opinion and by the "Ask TenjiCheck"
# assistant (the Next.js server reads it from here). A GitHub token with models:read. Server-side only. Leave empty to disable.
TC_GITHUB_MODELS_TOKEN=
TC_GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# OpenStreetMap pedestrian network via Overpass (optional; data is ODbL, attribution required)
TC_OSM_ENABLED=true
TC_OVERPASS_URL=https://overpass-api.de/api/interpreter

TC_PUBLIC_RATE_LIMIT_PER_MINUTE=10
TC_SEED_DEMO=true
